<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f5f7" id="themeColor">
  <title>Заметки</title>

  <script>
    try {
      document.documentElement.dataset.theme =
        localStorage.getItem("notes-theme") === "dark" ? "dark" : "light";
    } catch {
      document.documentElement.dataset.theme = "light";
    }
  </script>

  <style>
    :root {
      color-scheme: light;
      --page: #f5f5f7;
      --sidebar: #ececf0;
      --surface: #fff;
      --soft: #f0f0f3;
      --hover: #e5e5ea;
      --border: #e5e5ea;
      --text: #25252b;
      --muted: #777783;
      --accent: #f4c543;
      --accent-hover: #ffd35d;
      --accent-text: #342900;
      --shadow: 0 10px 30px #2525360c;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    :root[data-theme="dark"] {
      color-scheme: dark;
      --page: #111218;
      --sidebar: #191a22;
      --surface: #20212b;
      --soft: #292a36;
      --hover: #333441;
      --border: #373844;
      --text: #f1f1f5;
      --muted: #aaaab7;
      --accent: #f4c543;
      --accent-hover: #ffd35d;
      --accent-text: #342900;
      --shadow: 0 10px 30px #0004;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--page);
      color: var(--text);
    }

    body, aside, main, .editor, .card, .tool, input, select {
      transition:
        background-color .25s ease,
        color .25s ease,
        border-color .25s ease,
        box-shadow .25s ease;
    }

    button, input, select { font: inherit; }
    button { cursor: pointer; }
    button:disabled { opacity: .55; cursor: not-allowed; }

    [hidden] { display: none !important; }

    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    [contenteditable]:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .app {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      min-height: 100vh;
    }

    aside {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 22px 14px;
      border-right: 1px solid var(--border);
      background: var(--sidebar);
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .aside-top, .topbar, .editor-header, .editor-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .brand {
      padding-left: 10px;
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -1px;
      white-space: nowrap;
    }

    .brand span { color: #e5ae1f; }

    .nav-title {
      margin: 0 12px 8px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: .1em;
    }

    .nav {
      width: 100%;
      padding: 11px 13px;
      border: 0;
      border-radius: 11px;
      background: transparent;
      color: var(--text);
      text-align: left;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      transition: transform .2s ease, background-color .2s ease;
    }

    .nav:hover {
      background: var(--hover);
      transform: translateX(3px);
    }

    .nav.active {
      background: var(--surface);
      box-shadow: var(--shadow);
      font-weight: 700;
    }

    .nav span:first-child {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .count { color: var(--muted); }

    main {
      width: min(100%, 1120px);
      padding: 26px 42px 70px;
      margin: 0 auto;
    }

    .topbar { margin-bottom: 38px; }

    .top-left, .top-right, .editor-left, .editor-right {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .icon, .soft, .tool {
      border: 1px solid var(--border);
      border-radius: 11px;
      background: var(--surface);
      color: var(--text);
      transition:
        transform .2s ease,
        background-color .2s ease,
        border-color .2s ease;
    }

    .icon:hover:not(:disabled),
    .soft:hover:not(:disabled),
    .tool:hover:not(:disabled) {
      transform: translateY(-2px);
      background: var(--hover);
    }

    .icon {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      font-size: 20px;
    }

    .soft { padding: 10px 13px; }

    .primary {
      padding: 11px 17px;
      border: 0;
      border-radius: 11px;
      background: var(--accent);
      color: var(--accent-text);
      font-weight: 750;
      transition: transform .2s ease, background-color .2s ease;
    }

    .primary:hover:not(:disabled) {
      transform: translateY(-2px);
      background: var(--accent-hover);
    }

    h1 {
      margin: 0;
      font-size: clamp(32px, 5vw, 48px);
      letter-spacing: -2px;
    }

    .subtitle {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    .filters {
      display: flex;
      gap: 10px;
      margin: 25px 0 22px;
    }

    .search {
      flex: 1;
      min-width: 0;
      height: 46px;
      padding: 0 16px;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: var(--surface);
      color: var(--text);
    }

    .sort {
      max-width: 175px;
      padding: 0 10px;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: var(--surface);
      color: var(--text);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 15px;
    }

    .card {
      min-height: 155px;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      color: var(--text);
      text-align: left;
      box-shadow: var(--shadow);
      animation: appear .3s ease both;
      transition: transform .22s ease, box-shadow .22s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px #0002;
    }

    .card-title {
      font-weight: 750;
      overflow-wrap: anywhere;
    }

    .preview {
      min-height: 55px;
      margin: 13px 0 17px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }

    .card-foot {
      color: var(--muted);
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .empty {
      grid-column: 1 / -1;
      padding: 65px 20px;
      border: 1px dashed var(--border);
      border-radius: 15px;
      color: var(--muted);
      text-align: center;
    }

    .editor {
      position: fixed;
      z-index: 20;
      inset: 0;
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--surface);
      animation: editor-in .3s ease both;
    }

    .editor.closing {
      animation: editor-out .22s ease both;
      pointer-events: none;
    }

    .editor-header {
      flex: 0 0 auto;
      min-height: 68px;
      padding: 10px clamp(16px, 4vw, 48px);
      border-bottom: 1px solid var(--border);
    }

    .editor-scroll {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
    }

    .editor-inner {
      width: min(100%, 960px);
      min-height: 100%;
      margin: auto;
      padding: 38px clamp(20px, 5vw, 55px) 70px;
    }

    .kicker, .label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .title-input {
      width: 100%;
      margin: 18px 0 15px;
      padding: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-size: clamp(34px, 5vw, 52px);
      font-weight: 760;
      letter-spacing: -1.6px;
    }

    .title-input::placeholder,
    .note-body:empty::before {
      color: var(--muted);
    }

    .toolbar {
      position: sticky;
      top: 0;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      padding: 12px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }

    .tool {
      min-height: 38px;
      padding: 7px 11px;
      font-size: 13px;
    }

    .tool b, .tool i, .tool s { font-size: 15px; }

    .note-body {
      min-height: 32vh;
      padding: 22px 2px;
      outline: none;
      color: var(--text);
      font-size: 17px;
      line-height: 1.75;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    .note-body:empty::before {
      content: "Начните писать или выделите текст для форматирования…";
      pointer-events: none;
    }

    .note-body code {
      padding: 2px 6px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--soft);
      color: var(--text);
      font: .9em/1.6 ui-monospace, SFMono-Regular, Consolas, monospace;
      cursor: copy;
    }

    .note-body code:hover { background: var(--hover); }

    .todo-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 7px 0;
    }

    .todo-row input {
      flex: 0 0 18px;
      width: 18px;
      height: 18px;
      margin: 7px 0 0;
      accent-color: #e5ae1f;
      cursor: pointer;
    }

    .todo-text {
      min-width: 0;
      flex: 1;
    }

    .todo-row.done .todo-text {
      text-decoration: line-through;
      color: var(--muted);
    }

    .hint {
      margin-top: 4px;
      color: var(--muted);
      font-size: 12px;
    }

    .attachments {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 10px;
    }

    .attachment {
      position: relative;
      width: 135px;
      min-height: 95px;
      border-radius: 10px;
      background: var(--soft);
      overflow: hidden;
    }

    .attachment img {
      display: block;
      width: 135px;
      height: 95px;
      object-fit: cover;
    }

    .attachment a {
      display: block;
      padding: 14px 10px;
      color: var(--text);
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .attachment button {
      position: absolute;
      right: 4px;
      top: 4px;
      width: 26px;
      height: 26px;
      border: 0;
      border-radius: 50%;
      background: #262630e0;
      color: white;
    }

    .meta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 15px;
      margin-top: 30px;
      padding-top: 25px;
      border-top: 1px solid var(--border);
    }

    .meta label {
      display: grid;
      gap: 8px;
      color: var(--muted);
      font-size: 13px;
    }

    .meta input, .meta select {
      min-width: 0;
      height: 42px;
      padding: 0 10px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: var(--surface);
      color: var(--text);
    }

    .editor-footer {
      flex: 0 0 auto;
      min-height: 72px;
      padding: 10px clamp(16px, 4vw, 48px);
      border-top: 1px solid var(--border);
      background: var(--surface);
    }

    .footer-left {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .danger { color: #d75454; }
    :root[data-theme="dark"] .danger { color: #ff9292; }

    .toast {
      position: fixed;
      z-index: 100;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      max-width: calc(100vw - 25px);
      padding: 11px 16px;
      border-radius: 10px;
      background: #34343d;
      color: white;
      text-align: center;
      font-size: 14px;
      box-shadow: 0 8px 25px #0004;
    }

    .mobile-only { display: none; }

    @keyframes appear {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes editor-in {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes editor-out {
      to { opacity: 0; transform: translateY(12px); }
    }

    @media (max-width: 700px) {
      .app { display: block; }

      aside {
        position: fixed;
        z-index: 12;
        left: 0;
        width: min(82vw, 280px);
        transform: translateX(-100%);
        transition: transform .25s ease, background-color .25s ease;
      }

      aside.open { transform: translateX(0); }

      .backdrop:not([hidden]) {
        position: fixed;
        z-index: 11;
        inset: 0;
        display: block;
        width: 100%;
        border: 0;
        background: #0008;
      }

      .mobile-only { display: inline-block; }

      main { padding: 17px 17px 60px; }
      .topbar { margin-bottom: 28px; }
      .grid { grid-template-columns: 1fr; }
      .editor-inner { padding: 28px 19px 50px; }

      .editor-header, .editor-footer {
        padding-left: 12px;
        padding-right: 12px;
      }

      .meta { grid-template-columns: 1fr; }

      .tool {
        font-size: 12px;
        padding: 7px 9px;
      }

      .sort { max-width: 125px; }
      #fullscreenButton { display: none; }
    }

    @media (max-width: 380px) {
      .top-right { gap: 5px; }
      .top-right .soft { padding: 9px; }
      #newNote { padding: 10px; font-size: 13px; }
      .editor-header .theme-toggle { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <aside id="sidebar">
      <div class="aside-top">
        <div class="brand">Заметки<span>.</span></div>
        <button class="icon theme-toggle" type="button" aria-label="Переключить тему">☾</button>
      </div>

      <div>
        <div class="nav-title">Библиотека</div>

        <button class="nav active" type="button" data-view="all">
          Все заметки <span class="count" id="allCount">0</span>
        </button>

        <button class="nav" type="button" data-view="pinned">
          Закреплённые <span class="count" id="pinnedCount">0</span>
        </button>
      </div>

      <div>
        <div class="nav-title">Папки</div>
        <div id="folderNav"></div>
        <button class="nav" type="button" id="addFolder">＋ Новая папка</button>
      </div>

      <div style="margin-top:auto">
        <button class="nav" type="button" id="shareSide">↗ Поделиться списком</button>
      </div>
    </aside>

    <button
      class="backdrop"
      id="backdrop"
      type="button"
      hidden
      aria-label="Закрыть меню"
    ></button>

    <main>
      <div class="topbar">
        <div class="top-left">
          <button class="icon mobile-only" id="openSidebar" type="button" aria-label="Открыть меню">☰</button>
          <button class="icon theme-toggle" type="button" aria-label="Переключить тему">☾</button>
        </div>

        <div class="top-right">
          <button class="soft" id="exportButton" type="button" title="Скачать резервную копию" aria-label="Экспорт">↓</button>
          <button class="soft" id="importButton" type="button" title="Импортировать резервную копию" aria-label="Импорт">↑</button>
          <button class="primary" id="newNote" type="button">＋ Новая заметка</button>
        </div>
      </div>

      <h1 id="pageTitle">Все заметки</h1>
      <p class="subtitle" id="pageSubtitle">Ваши мысли — в одном месте.</p>

      <div class="filters">
        <input
          class="search"
          id="search"
          type="search"
          placeholder="Поиск по заметкам, тегам и папкам…"
          aria-label="Поиск заметок"
        >

        <select class="sort" id="sortNotes" aria-label="Сортировка заметок">
          <option value="updated">Недавние</option>
          <option value="created">Новые</option>
          <option value="title">По названию</option>
        </select>
      </div>

      <div class="grid" id="notesGrid"></div>
    </main>
  </div>

  <section class="editor" id="editor" aria-label="Редактор заметки" hidden>
    <header class="editor-header">
      <div class="editor-left">
        <button class="icon theme-toggle" type="button" aria-label="Переключить тему">☾</button>
        <button class="soft" id="closeEditor" type="button">← Назад</button>
      </div>

      <div class="editor-right">
        <button class="soft" id="fullscreenButton" type="button">⛶ На весь экран</button>
      </div>
    </header>

    <div class="editor-scroll">
      <div class="editor-inner">
        <div class="kicker" id="editorKicker">НОВАЯ ЗАМЕТКА</div>

        <input
          class="title-input"
          id="noteTitle"
          maxlength="120"
          placeholder="Название заметки"
          aria-label="Название заметки"
        >

        <div class="toolbar" id="toolbar" aria-label="Форматирование текста">
          <button class="tool" type="button" data-format="todo" title="Сделать туду-пункт из выделенного текста">
            ☑ Туду-лист
          </button>

          <button class="tool" type="button" data-format="code" title="Нажмите на оформленный текст, чтобы скопировать его">
            &lt;/&gt; Моноширинный
          </button>

          <button class="tool" type="button" data-format="bold" title="Жирный текст">
            <b>Жирный</b>
          </button>

          <button class="tool" type="button" data-format="italic" title="Курсив">
            <i>Курсив</i>
          </button>

          <button class="tool" type="button" data-format="strike" title="Зачёркнутый текст">
            <s>Зачёркнутый</s>
          </button>
        </div>

        <div
          id="noteBody"
          class="note-body"
          contenteditable="true"
          role="textbox"
          aria-label="Текст заметки"
          aria-multiline="true"
          spellcheck="true"
        ></div>

        <div class="hint">
          Выделите текст и нажмите кнопку форматирования.
          Нажатие на моноширинный текст копирует его.
        </div>

        <div id="attachmentsSection" hidden>
          <div class="label" style="margin-top:30px">Вложения</div>
          <div class="attachments" id="attachments"></div>
        </div>

        <div class="meta">
          <label>
            Папка
            <select id="noteFolder"></select>
          </label>

          <label>
            Теги через запятую
            <input id="noteTags" placeholder="идеи, работа">
          </label>

          <label>
            Напомнить
            <input id="noteReminder" type="datetime-local">
          </label>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:18px">
          <button class="soft" id="addImage" type="button">＋ Картинка</button>
          <button class="soft" id="addFile" type="button">＋ Файл</button>
          <button class="soft" id="addLink" type="button">＋ Ссылка</button>
        </div>
      </div>
    </div>

    <footer class="editor-footer">
      <div class="footer-left">
        <button class="soft" id="pinNote" type="button">☆ Закрепить</button>
        <button class="soft danger" id="deleteNote" type="button" hidden>Удалить</button>
      </div>

      <button class="primary" id="saveNote" type="button">Сохранить</button>
    </footer>
  </section>

  <input
    type="file"
    id="imageInput"
    accept="image/png,image/jpeg,image/gif,image/webp,image/avif"
    multiple
    hidden
  >
  <input type="file" id="fileInput" multiple hidden>
  <input type="file" id="importInput" accept=".json,application/json" hidden>

  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

  <script>
    "use strict";

    const $ = selector => document.querySelector(selector);

    // Имя базы оставлено прежним: заметки из предыдущей версии сохранятся.
    const DB_NAME = "beautiful-notes-db";
    const MAX_FILE_BYTES = 5 * 1024 * 1024;
    const MAX_IMPORT_BYTES = 80 * 1024 * 1024;
    const IMAGE_TYPES = new Set([
      "image/png",
      "image/jpeg",
      "image/gif",
      "image/webp",
      "image/avif"
    ]);

    let db;
    let notes = [];
    let folders = ["Личные", "Работа", "Идеи"];
    let currentView = "all";
    let draft = null;
    let initialSnapshot = "";
    let savedRange = null;
    let toastTimer;
    let closeTimer;
    let saving = false;

    function uid() {
      return globalThis.crypto?.randomUUID?.() ||
        Date.now() + "-" + Math.random().toString(36).slice(2);
    }

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function notify(message) {
      const toast = $("#toast");
      toast.textContent = message;
      toast.hidden = false;

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.hidden = true;
      }, 3200);
    }

    function setTheme(theme) {
      const dark = theme === "dark";

      document.documentElement.dataset.theme = dark ? "dark" : "light";
      $("#themeColor").content = dark ? "#111218" : "#f5f5f7";

      document.querySelectorAll(".theme-toggle").forEach(button => {
        button.textContent = dark ? "☀" : "☾";
        button.title = dark
          ? "Включить светлую тему"
          : "Включить тёмную тему";
        button.setAttribute("aria-label", button.title);
      });

      try {
        localStorage.setItem("notes-theme", dark ? "dark" : "light");
      } catch {
        // Тема продолжит работать до перезагрузки страницы.
      }
    }

    function openDB() {
      return new Promise((resolve, reject) => {
        const request = indexedDB.open(DB_NAME, 1);

        request.onupgradeneeded = () => {
          const database = request.result;

          if (!database.objectStoreNames.contains("notes")) {
            database.createObjectStore("notes", { keyPath: "id" });
          }

          if (!database.objectStoreNames.contains("settings")) {
            database.createObjectStore("settings", { keyPath: "key" });
          }
        };

        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
        request.onblocked = () =>
          reject(new Error("База данных заблокирована другой вкладкой"));
      });
    }

    function transaction(storeName, mode, callback) {
      return new Promise((resolve, reject) => {
        let tx;
        let request;

        try {
          tx = db.transaction(storeName, mode);
          request = callback(tx.objectStore(storeName));
        } catch (error) {
          reject(error);
          return;
        }

        let result;

        request.onsuccess = () => {
          result = request.result;
        };

        tx.oncomplete = () => resolve(result);
        tx.onerror = () => reject(tx.error || new Error("Ошибка хранилища"));
        tx.onabort = () => reject(tx.error || new Error("Операция отменена"));
      });
    }

    const getAllNotes = () =>
      transaction("notes", "readonly", store => store.getAll());

    const putNote = note =>
      transaction("notes", "readwrite", store => store.put(note));

    const removeNote = id =>
      transaction("notes", "readwrite", store => store.delete(id));

    const getSavedFolders = () =>
      transaction("settings", "readonly", store => store.get("folders"));

    const saveFolders = () =>
      transaction("settings", "readwrite", store =>
        store.put({ key: "folders", value: folders })
      );

    function formatDate(value) {
      const date = new Date(value || Date.now());

      if (Number.isNaN(date.getTime())) return "Без даты";

      return new Intl.DateTimeFormat("ru", {
        day: "numeric",
        month: "short",
        year: "numeric"
      }).format(date);
    }

    function closeSidebar() {
      $("#sidebar").classList.remove("open");
      $("#backdrop").hidden = true;
    }

    function visibleNotes() {
      const query = $("#search").value.trim().toLocaleLowerCase("ru");
      const sort = $("#sortNotes").value;

      return notes.filter(note => {
        if (currentView === "pinned" && !note.pinned) return false;

        if (
          currentView.startsWith("folder:") &&
          note.folder !== currentView.slice(7)
        ) {
          return false;
        }

        const searchable = [
          note.title,
          note.text,
          note.folder,
          ...(Array.isArray(note.tags) ? note.tags : []),
          ...(Array.isArray(note.checks)
            ? note.checks.map(item => item?.text)
            : [])
        ].join(" ").toLocaleLowerCase("ru");

        return searchable.includes(query);
      }).sort((a, b) => {
        const pinDifference =
          Number(Boolean(b.pinned)) - Number(Boolean(a.pinned));

        if (pinDifference) return pinDifference;

        if (sort === "title") {
          return String(a.title || "").localeCompare(
            String(b.title || ""),
            "ru"
          );
        }

        const field = sort === "created" ? "createdAt" : "updatedAt";

        return (Number(b[field]) || 0) - (Number(a[field]) || 0);
      });
    }

    function render() {
      $("#allCount").textContent = notes.length;
      $("#pinnedCount").textContent =
        notes.filter(note => note.pinned).length;

      document.querySelectorAll("[data-view]").forEach(button => {
        button.classList.toggle(
          "active",
          button.dataset.view === currentView
        );
      });

      $("#folderNav").innerHTML = folders.map(folder => {
        const count =
          notes.filter(note => note.folder === folder).length;

        return `
          <button
            class="nav ${currentView === "folder:" + folder ? "active" : ""}"
            type="button"
            data-folder="${escapeHTML(folder)}"
          >
            <span>▤ ${escapeHTML(folder)}</span>
            <span class="count">${count}</span>
          </button>
        `;
      }).join("");

      $("#pageTitle").textContent =
        currentView === "all"
          ? "Все заметки"
          : currentView === "pinned"
            ? "Закреплённые"
            : currentView.slice(7);

      const shown = visibleNotes();

      $("#pageSubtitle").textContent =
        `${shown.length} заметок · Ваши мысли — в одном месте.`;

      $("#notesGrid").innerHTML = shown.length
        ? shown.map(note => `
          <button
            class="card"
            type="button"
            data-id="${escapeHTML(note.id)}"
          >
            <div class="card-title">
              ${escapeHTML(note.title || "Без названия")}
              ${note.pinned ? " ★" : ""}
            </div>

            <div class="preview">${escapeHTML(
              note.text ||
              (note.attachments?.length ? "Вложения" : "Пустая заметка")
            )}</div>

            <div class="card-foot">
              ${formatDate(note.updatedAt)}
              ${note.folder ? " · " + escapeHTML(note.folder) : ""}
              ${note.attachments?.length
                ? " · ▧ " + note.attachments.length
                : ""}
            </div>
          </button>
        `).join("")
        : `<div class="empty">Пока здесь пусто. Создайте заметку!</div>`;
    }

    function renderFolderOptions() {
      $("#noteFolder").innerHTML =
        `<option value="">Без папки</option>` +
        folders.map(folder => `
          <option value="${escapeHTML(folder)}">
            ${escapeHTML(folder)}
          </option>
        `).join("");
    }

    /*
      Разрешаем только элементы форматирования редактора.
      Скрипты, стили, SVG, iframe и прочие опасные элементы
      удаляем целиком, а не превращаем в текст.
    */
    function sanitizeRichHTML(html) {
      const template = document.createElement("template");
      template.innerHTML = String(html || "");

      const allowed = new Set([
        "DIV", "P", "BR", "STRONG", "B",
        "EM", "I", "S", "STRIKE", "CODE", "SPAN"
      ]);

      const discard = new Set([
        "SCRIPT", "STYLE", "IFRAME", "OBJECT", "EMBED",
        "SVG", "MATH", "FORM", "TEMPLATE", "META",
        "LINK", "BASE", "VIDEO", "AUDIO"
      ]);

      function cleanNode(node, insideTodo = false) {
        if (node.nodeType === Node.TEXT_NODE) {
          return document.createTextNode(node.textContent);
        }

        if (node.nodeType !== Node.ELEMENT_NODE) {
          return document.createDocumentFragment();
        }

        if (discard.has(node.tagName)) {
          return document.createDocumentFragment();
        }

        if (node.tagName === "INPUT") {
          if (!insideTodo || node.type !== "checkbox") {
            return document.createDocumentFragment();
          }

          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.checked =
            node.checked || node.hasAttribute("checked");
          checkbox.setAttribute(
            "aria-label",
            "Отметить выполненным"
          );

          if (checkbox.checked) {
            checkbox.setAttribute("checked", "");
          }

          return checkbox;
        }

        if (!allowed.has(node.tagName)) {
          const fragment = document.createDocumentFragment();

          node.childNodes.forEach(child => {
            fragment.append(cleanNode(child, insideTodo));
          });

          return fragment;
        }

        const element =
          document.createElement(node.tagName.toLowerCase());

        const isTodo =
          node.tagName === "DIV" &&
          node.classList.contains("todo-row");

        if (isTodo) {
          element.className = "todo-row";

          if (node.classList.contains("done")) {
            element.classList.add("done");
          }
        }

        if (
          node.tagName === "SPAN" &&
          node.classList.contains("todo-text")
        ) {
          element.className = "todo-text";
        }

        node.childNodes.forEach(child => {
          element.append(cleanNode(child, insideTodo || isTodo));
        });

        return element;
      }

      const result = document.createElement("div");

      template.content.childNodes.forEach(node => {
        result.append(cleanNode(node));
      });

      return result.innerHTML;
    }

    function safeLink(value) {
      try {
        const url = new URL(String(value));

        return ["http:", "https:"].includes(url.protocol)
          ? url.href
          : null;
      } catch {
        return null;
      }
    }

    function safeAttachment(value) {
      if (!value || typeof value !== "object") return null;

      const name =
        String(value.name || "Без названия").slice(0, 180);
      const id =
        typeof value.id === "string" ? value.id : uid();

      if (value.kind === "link") {
        const url = safeLink(value.url);

        return url
          ? { id, kind: "link", name, url }
          : null;
      }

      if (typeof value.data !== "string") return null;

      // Ограничиваем размер и требуем именно base64 data URL.
      if (
        value.data.length > MAX_FILE_BYTES * 1.4 + 200 ||
        !/^data:[^,]*;base64,[a-z0-9+/=\s]+$/i.test(value.data)
      ) {
        return null;
      }

      const comma = value.data.indexOf(",");
      const base64 = value.data.slice(comma + 1).replace(/\s/g, "");

      if (!base64 || base64.length > MAX_FILE_BYTES * 1.4 + 100) {
        return null;
      }

      if (value.kind === "image") {
        const match =
          /^data:(image\/(?:png|jpeg|gif|webp|avif));base64,/i.exec(
            value.data
          );

        if (!match) return null;

        return {
          id,
          kind: "image",
          name,
          data: `data:${match[1].toLowerCase()};base64,${base64}`
        };
      }

      if (value.kind === "file") {
        // Вложения скачиваются как бинарные файлы, а не открываются
        // как HTML или скрипт из потенциально опасного data URL.
        return {
          id,
          kind: "file",
          name,
          data: `data:application/octet-stream;base64,${base64}`
        };
      }

      return null;
    }

    function renderAttachments() {
      if (!draft) return;

      const container = $("#attachments");
      container.replaceChildren();

      $("#attachmentsSection").hidden = !draft.attachments.length;

      draft.attachments.forEach((attachment, index) => {
        const box = document.createElement("div");
        box.className = "attachment";

        if (attachment.kind === "image") {
          const image = document.createElement("img");
          image.src = attachment.data;
          image.alt = attachment.name;
          image.loading = "lazy";
          box.append(image);
        } else {
          const link = document.createElement("a");

          link.href = attachment.kind === "link"
            ? attachment.url
            : attachment.data;

          link.textContent =
            (attachment.kind === "link" ? "↗ " : "▤ ") +
            attachment.name;

          if (attachment.kind === "link") {
            link.target = "_blank";
            link.rel = "noopener noreferrer";
          } else {
            link.download = attachment.name;
          }

          box.append(link);
        }

        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "×";
        remove.title = "Удалить вложение";
        remove.setAttribute(
          "aria-label",
          `Удалить вложение ${attachment.name}`
        );

        remove.onclick = () => {
          draft.attachments.splice(index, 1);
          renderAttachments();
        };

        box.append(remove);
        container.append(box);
      });
    }

    function updatePinButton() {
      $("#pinNote").textContent =
        draft?.pinned ? "★ Закреплено" : "☆ Закрепить";
    }

    function createTodoRow(text = "", done = false) {
      const row = document.createElement("div");
      row.className = "todo-row";

      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = Boolean(done);
      checkbox.setAttribute(
        "aria-label",
        "Отметить выполненным"
      );

      const content = document.createElement("span");
      content.className = "todo-text";
      content.textContent = text || "\u200B";

      if (done) row.classList.add("done");

      row.append(checkbox, content);
      return row;
    }

    function serializedBody() {
      const copy = $("#noteBody").cloneNode(true);

      copy.querySelectorAll(".todo-row").forEach(row => {
        const checkbox =
          row.querySelector('input[type="checkbox"]');

        if (!checkbox) return;

        row.classList.toggle("done", checkbox.checked);

        if (checkbox.checked) {
          checkbox.setAttribute("checked", "");
        } else {
          checkbox.removeAttribute("checked");
        }
      });

      return sanitizeRichHTML(copy.innerHTML);
    }

    function formSnapshot() {
      return JSON.stringify({
        title: $("#noteTitle").value,
        richHTML: serializedBody(),
        folder: $("#noteFolder").value,
        tags: $("#noteTags").value,
        reminder: $("#noteReminder").value,
        pinned: Boolean(draft?.pinned),
        attachments: draft?.attachments || []
      });
    }

    function openEditor(note = null) {
      clearTimeout(closeTimer);

      const editor = $("#editor");
      editor.classList.remove("closing");

      draft = note
        ? structuredClone(note)
        : {
            id: uid(),
            title: "",
            text: "",
            richHTML: "",
            folder: currentView.startsWith("folder:")
              ? currentView.slice(7)
              : "",
            tags: [],
            checks: [],
            attachments: [],
            reminder: "",
            notified: false,
            pinned: false,
            createdAt: Date.now()
          };

      draft.tags = Array.isArray(draft.tags)
        ? draft.tags.filter(tag => typeof tag === "string")
        : [];

      draft.checks = Array.isArray(draft.checks)
        ? draft.checks
        : [];

      draft.attachments = Array.isArray(draft.attachments)
        ? draft.attachments.map(safeAttachment).filter(Boolean)
        : [];

      renderFolderOptions();

      $("#editorKicker").textContent =
        note ? "РЕДАКТИРОВАНИЕ ЗАМЕТКИ" : "НОВАЯ ЗАМЕТКА";

      $("#noteTitle").value = draft.title || "";
      $("#noteFolder").value = draft.folder || "";
      $("#noteTags").value = draft.tags.join(", ");
      $("#noteReminder").value = draft.reminder || "";
      $("#deleteNote").hidden = !note;

      const body = $("#noteBody");
      const hasRichHTML = Boolean(draft.richHTML);

      body.innerHTML = hasRichHTML
        ? sanitizeRichHTML(draft.richHTML)
        : escapeHTML(draft.text || "").replace(/\n/g, "<br>");

      // Старые пункты переносим только при отсутствии richHTML.
      // Иначе при каждом открытии они дублировались бы.
      if (!hasRichHTML) {
        for (const item of draft.checks) {
          body.append(createTodoRow(
            String(item?.text || ""),
            Boolean(item?.done)
          ));
        }
      }

      draft.checks = [];

      renderAttachments();
      updatePinButton();

      savedRange = null;
      editor.hidden = false;
      $(".editor-scroll").scrollTop = 0;
      document.body.style.overflow = "hidden";

      initialSnapshot = formSnapshot();
      $("#noteTitle").focus();
    }

    async function closeEditor(force = false) {
      const editor = $("#editor");

      if (
        editor.hidden ||
        editor.classList.contains("closing") ||
        (saving && !force)
      ) {
        return;
      }

      if (
        !force &&
        draft &&
        formSnapshot() !== initialSnapshot &&
        !confirm("Есть несохранённые изменения. Закрыть заметку?")
      ) {
        return;
      }

      if (document.fullscreenElement === editor) {
        try {
          await document.exitFullscreen();
        } catch {
          // Редактор всё равно закроется.
        }
      }

      editor.classList.add("closing");

      closeTimer = setTimeout(() => {
        editor.hidden = true;
        editor.classList.remove("closing");
        document.body.style.overflow = "";
        draft = null;
        savedRange = null;
        initialSnapshot = "";
      }, matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 220);
    }

    function rememberSelection() {
      const selection = window.getSelection();

      if (!selection || !selection.rangeCount) return;

      const range = selection.getRangeAt(0);
      const body = $("#noteBody");

      if (
        body.contains(range.startContainer) &&
        body.contains(range.endContainer)
      ) {
        savedRange = range.cloneRange();
      }
    }

    function restoreSelection() {
      if (!savedRange) return null;

      const body = $("#noteBody");

      if (
        !body.contains(savedRange.startContainer) ||
        !body.contains(savedRange.endContainer)
      ) {
        return null;
      }

      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(savedRange);

      return selection.getRangeAt(0);
    }

    function putCaretAfter(node) {
      const range = document.createRange();
      range.setStartAfter(node);
      range.collapse(true);

      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);

      savedRange = range.cloneRange();
    }

    function formatSelection(format) {
      const range = restoreSelection();

      if (!range) {
        notify("Сначала поставьте курсор или выделите текст в заметке");
        return;
      }

      const selectedText = window.getSelection().toString();

      if (format === "todo") {
        const insideTodo =
          range.startContainer.parentElement?.closest(".todo-row");

        if (insideTodo) {
          notify("Курсор уже находится внутри туду-пункта");
          return;
        }

        const lines = selectedText
          ? selectedText.split(/\r?\n/).filter(line => line.trim())
          : [""];

        if (!lines.length) {
          notify("В выделении нет текста");
          return;
        }

        const rows = lines.map(line => createTodoRow(line));
        const fragment = document.createDocumentFragment();

        rows.forEach(row => fragment.append(row));

        range.deleteContents();
        range.insertNode(fragment);
        putCaretAfter(rows[rows.length - 1]);

        notify("Туду-лист добавлен");
        return;
      }

      if (!selectedText) {
        notify("Сначала выделите текст, который нужно оформить");
        return;
      }

      const tag = {
        code: "code",
        bold: "strong",
        italic: "em",
        strike: "s"
      }[format];

      if (!tag) return;

      const wrapper = document.createElement(tag);
      wrapper.append(range.extractContents());
      range.insertNode(wrapper);
      putCaretAfter(wrapper);

      notify(
        format === "code"
          ? "Готово. Нажмите на текст, чтобы скопировать"
          : "Форматирование применено"
      );
    }

    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        notify("Скопировано");
      } catch {
        const helper = document.createElement("textarea");
        helper.value = text;
        helper.style.position = "fixed";
        helper.style.opacity = "0";

        document.body.append(helper);
        helper.select();

        const success = document.execCommand("copy");
        helper.remove();

        notify(
          success ? "Скопировано" : "Не удалось скопировать"
        );
      }
    }

    async function saveEditor() {
      if (
        !draft ||
        saving ||
        $("#editor").classList.contains("closing")
      ) {
        return;
      }

      saving = true;
      $("#saveNote").disabled = true;

      const saved = {
        ...draft,
        title: $("#noteTitle").value.trim(),
        richHTML: serializedBody(),
        text: $("#noteBody").innerText
          .replace(/\u200B/g, "")
          .trim(),
        folder: $("#noteFolder").value,
        tags: [...new Set(
          $("#noteTags").value
            .split(",")
            .map(tag => tag.trim())
            .filter(Boolean)
        )],
        checks: [],
        reminder: $("#noteReminder").value,
        updatedAt: Date.now()
      };

      if (saved.reminder !== draft.reminder) {
        saved.notified = false;
      }

      try {
        await putNote(saved);
        notes = await getAllNotes();
        render();

        await closeEditor(true);
        notify("Заметка сохранена");
      } catch (error) {
        console.error(error);
        notify(
          "Не удалось сохранить заметку. Проверьте свободное место"
        );
      } finally {
        saving = false;
        $("#saveNote").disabled = false;
      }
    }

    function readAsDataURL(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });
    }

    async function handleFiles(files, imagesOnly) {
      if (!draft) return;

      const targetDraft = draft;

      for (const file of files) {
        if (file.size > MAX_FILE_BYTES) {
          notify(`Файл «${file.name}» больше 5 МБ`);
          continue;
        }

        if (imagesOnly && !IMAGE_TYPES.has(file.type)) {
          notify(`Формат картинки «${file.name}» не поддерживается`);
          continue;
        }

        try {
          const data = await readAsDataURL(file);

          // Если за время чтения пользователь закрыл заметку,
          // не добавляем вложение в уже закрытый редактор.
          if (draft !== targetDraft) return;

          const attachment = safeAttachment({
            id: uid(),
            kind: imagesOnly ? "image" : "file",
            name: file.name,
            data
          });

          if (!attachment) {
            notify(`Не удалось добавить «${file.name}»`);
            continue;
          }

          targetDraft.attachments.push(attachment);
        } catch {
          notify(`Не удалось прочитать «${file.name}»`);
        }
      }

      if (draft === targetDraft) renderAttachments();
    }

    function shareText() {
      return visibleNotes().map(note => [
        note.title || "Без названия",
        note.text || "",
        (Array.isArray(note.tags) ? note.tags : [])
          .map(tag => "#" + tag)
          .join(" ")
      ].filter(Boolean).join("\n")).join("\n\n──────────\n\n");
    }

    async function shareNotes() {
      const text = shareText();

      if (!text) {
        notify("Нет заметок, которыми можно поделиться");
        return;
      }

      if (navigator.share) {
        try {
          await navigator.share({
            title: "Мои заметки",
            text
          });
          return;
        } catch (error) {
          if (error.name === "AbortError") return;
        }
      }

      await copyText(text);
    }

    function exportNotes() {
      const data = JSON.stringify({
        version: 3,
        folders,
        notes
      }, null, 2);

      const blob = new Blob([data], {
        type: "application/json"
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = "zametki-backup.json";
      document.body.append(link);
      link.click();
      link.remove();

      setTimeout(() => URL.revokeObjectURL(url), 1000);
      notify("Резервная копия скачана");
    }

    function normalizeImportedNote(value) {
      if (
        !value ||
        typeof value !== "object" ||
        typeof value.id !== "string" ||
        !value.id ||
        typeof value.title !== "string"
      ) {
        return null;
      }

      return {
        id: value.id.slice(0, 180),
        title: value.title.slice(0, 120),
        text:
          typeof value.text === "string" ? value.text : "",
        richHTML:
          typeof value.richHTML === "string"
            ? sanitizeRichHTML(value.richHTML)
            : "",
        folder:
          typeof value.folder === "string"
            ? value.folder.slice(0, 80)
            : "",
        tags: Array.isArray(value.tags)
          ? value.tags
              .filter(tag => typeof tag === "string")
              .map(tag => tag.slice(0, 80))
              .slice(0, 100)
          : [],
        checks: Array.isArray(value.checks)
          ? value.checks.slice(0, 1000).map(item => ({
              text: String(item?.text || "").slice(0, 2000),
              done: Boolean(item?.done)
            }))
          : [],
        attachments: Array.isArray(value.attachments)
          ? value.attachments
              .slice(0, 100)
              .map(safeAttachment)
              .filter(Boolean)
          : [],
        reminder:
          typeof value.reminder === "string"
            ? value.reminder.slice(0, 30)
            : "",
        notified: Boolean(value.notified),
        pinned: Boolean(value.pinned),
        createdAt:
          Number.isFinite(value.createdAt)
            ? value.createdAt
            : Date.now(),
        updatedAt:
          Number.isFinite(value.updatedAt)
            ? value.updatedAt
            : Date.now()
      };
    }

    async function importNotes(file) {
      try {
        if (file.size > MAX_IMPORT_BYTES) {
          notify("Резервная копия слишком большая");
          return;
        }

        const data = JSON.parse(await file.text());

        if (
          !data ||
          !Array.isArray(data.notes) ||
          !Array.isArray(data.folders) ||
          data.notes.length > 5000
        ) {
          throw new Error("Неверный формат резервной копии");
        }

        const approved = confirm(
          `Импортировать ${data.notes.length} заметок?\n` +
          "Заметки с совпадающими идентификаторами будут заменены."
        );

        if (!approved) return;

        const importedFolders = data.folders
          .filter(value => typeof value === "string")
          .map(value => value.trim().slice(0, 80))
          .filter(Boolean);

        const updatedFolders = [...new Set([
          ...folders,
          ...importedFolders
        ])];

        let count = 0;

        for (const value of data.notes) {
          const note = normalizeImportedNote(value);
          if (!note) continue;

          await putNote(note);
          count++;
        }

        folders = updatedFolders;
        await saveFolders();

        notes = await getAllNotes();
        render();

        notify(`Импортировано заметок: ${count}`);
      } catch (error) {
        console.error(error);

        // Если ошибка произошла после части записей, показываем
        // фактическое состояние базы, а не устаревший список.
        try {
          notes = await getAllNotes();
          render();
        } catch {}

        notify("Не удалось полностью импортировать файл");
      }
    }

    async function checkReminders() {
      const now = Date.now();

      for (const note of notes) {
        if (!note.reminder || note.notified) continue;

        const time = new Date(note.reminder).getTime();

        if (!Number.isFinite(time) || time > now) continue;

        note.notified = true;

        try {
          await putNote(note);
        } catch (error) {
          note.notified = false;
          console.error(error);
          continue;
        }

        notify(`Напоминание: ${note.title || "Без названия"}`);

        if (
          "Notification" in window &&
          Notification.permission === "granted"
        ) {
          try {
            new Notification(
              note.title || "Напоминание",
              {
                body: (
                  note.text || "Пора заглянуть в заметку"
                ).slice(0, 120)
              }
            );
          } catch {
            // В некоторых браузерах системные уведомления
            // недоступны даже при выданном разрешении.
          }
        }
      }
    }

    async function init() {
      setTheme(document.documentElement.dataset.theme);

      document.querySelectorAll(".theme-toggle").forEach(button => {
        button.onclick = () => {
          setTheme(
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark"
          );
        };
      });

      try {
        db = await openDB();
        notes = await getAllNotes();

        const saved = await getSavedFolders();

        if (Array.isArray(saved?.value)) {
          folders = saved.value.filter(
            value =>
              typeof value === "string" &&
              value.trim()
          );
        }
      } catch (error) {
        console.error(error);
        notify("Не удалось открыть хранилище браузера");

        $("#newNote").disabled = true;
        $("#importButton").disabled = true;
        $("#exportButton").disabled = true;
        return;
      }

      render();
      checkReminders();
      setInterval(checkReminders, 30000);

      $("#newNote").onclick = () => openEditor();
      $("#search").oninput = render;
      $("#sortNotes").onchange = render;

      $("#notesGrid").onclick = event => {
        const card = event.target.closest("[data-id]");
        if (!card) return;

        const note = notes.find(
          item => item.id === card.dataset.id
        );

        if (note) openEditor(note);
      };

      document.querySelectorAll("[data-view]").forEach(button => {
        button.onclick = () => {
          currentView = button.dataset.view;
          closeSidebar();
          render();
        };
      });

      $("#folderNav").onclick = event => {
        const button = event.target.closest("[data-folder]");
        if (!button) return;

        currentView = "folder:" + button.dataset.folder;
        closeSidebar();
        render();
      };

      $("#addFolder").onclick = async () => {
        const name =
          prompt("Название новой папки:")?.trim().slice(0, 80);

        if (!name) return;

        if (
          folders.some(folder =>
            folder.toLocaleLowerCase("ru") ===
            name.toLocaleLowerCase("ru")
          )
        ) {
          notify("Такая папка уже есть");
          return;
        }

        folders.push(name);

        try {
          await saveFolders();
          render();
          notify("Папка создана");
        } catch (error) {
          folders.pop();
          console.error(error);
          notify("Не удалось сохранить папку");
        }
      };

      $("#openSidebar").onclick = () => {
        $("#sidebar").classList.add("open");
        $("#backdrop").hidden = false;
      };

      $("#backdrop").onclick = closeSidebar;

      $("#shareSide").onclick = () => {
        closeSidebar();
        shareNotes();
      };

      $("#exportButton").onclick = exportNotes;
      $("#importButton").onclick = () => $("#importInput").click();

      $("#importInput").onchange = async event => {
        if (event.target.files[0]) {
          await importNotes(event.target.files[0]);
        }

        event.target.value = "";
      };

      $("#closeEditor").onclick = () => closeEditor();
      $("#saveNote").onclick = saveEditor;

      $("#deleteNote").onclick = async () => {
        if (
          !draft ||
          saving ||
          !confirm("Удалить эту заметку?")
        ) {
          return;
        }

        try {
          await removeNote(draft.id);
          notes = await getAllNotes();
          render();

          await closeEditor(true);
          notify("Заметка удалена");
        } catch (error) {
          console.error(error);
          notify("Не удалось удалить заметку");
        }
      };

      $("#pinNote").onclick = () => {
        if (!draft) return;

        draft.pinned = !draft.pinned;
        updatePinButton();
      };

      $("#fullscreenButton").onclick = async () => {
        try {
          if (document.fullscreenElement === $("#editor")) {
            await document.exitFullscreen();
          } else {
            await $("#editor").requestFullscreen();
          }
        } catch {
          notify(
            "Браузер не разрешил полноэкранный режим"
          );
        }
      };

      document.addEventListener("fullscreenchange", () => {
        $("#fullscreenButton").textContent =
          document.fullscreenElement === $("#editor")
            ? "⛶ Обычный режим"
            : "⛶ На весь экран";
      });

      // Сохраняем выделение до потери фокуса при нажатии
      // на кнопку панели форматирования.
      $("#toolbar").addEventListener("pointerdown", event => {
        if (event.target.closest("[data-format]")) {
          rememberSelection();
          event.preventDefault();
        }
      });

      $("#toolbar").onclick = event => {
        const button =
          event.target.closest("[data-format]");

        if (button) {
          formatSelection(button.dataset.format);
        }
      };

      document.addEventListener("selectionchange", () => {
        if (!$("#editor").hidden) rememberSelection();
      });

      $("#noteBody").addEventListener("change", event => {
        if (
          !event.target.matches(
            '.todo-row input[type="checkbox"]'
          )
        ) {
          return;
        }

        const row = event.target.closest(".todo-row");
        row?.classList.toggle(
          "done",
          event.target.checked
        );
      });

      $("#noteBody").addEventListener("click", event => {
        const code = event.target.closest("code");

        if (code && $("#noteBody").contains(code)) {
          copyText(code.textContent);
        }
      });

      // Вставляем из буфера обычный текст: оформление из чужих
      // страниц не ломает редактор и не приносит опасный HTML.
      $("#noteBody").addEventListener("paste", event => {
        const text =
          event.clipboardData?.getData("text/plain");

        if (text == null) return;

        event.preventDefault();

        const selection = window.getSelection();

        if (!selection?.rangeCount) return;

        const range = selection.getRangeAt(0);

        if (
          !$("#noteBody").contains(range.startContainer) ||
          !$("#noteBody").contains(range.endContainer)
        ) {
          return;
        }

        const node = document.createTextNode(text);

        range.deleteContents();
        range.insertNode(node);
        putCaretAfter(node);
      });

      $("#addImage").onclick = () => $("#imageInput").click();
      $("#addFile").onclick = () => $("#fileInput").click();

      $("#imageInput").onchange = async event => {
        await handleFiles([...event.target.files], true);
        event.target.value = "";
      };

      $("#fileInput").onchange = async event => {
        await handleFiles([...event.target.files], false);
        event.target.value = "";
      };

      $("#addLink").onclick = () => {
        if (!draft) return;

        let url = prompt("Вставьте ссылку:");
        if (!url) return;

        url = url.trim();

        if (!/^[a-z]+:\/\//i.test(url)) {
          url = "https://" + url;
        }

        const valid = safeLink(url);

        if (!valid) {
          notify(
            "Нужна ссылка вида https://example.com"
          );
          return;
        }

        const name =
          prompt("Название ссылки:", valid)?.trim() ||
          valid;

        draft.attachments.push({
          id: uid(),
          kind: "link",
          name: name.slice(0, 180),
          url: valid
        });

        renderAttachments();
      };

      document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
          closeSidebar();

          if (
            !$("#editor").hidden &&
            !document.fullscreenElement
          ) {
            closeEditor();
          }
        }

        if (
          (event.ctrlKey || event.metaKey) &&
          event.key.toLowerCase() === "s" &&
          !$("#editor").hidden
        ) {
          event.preventDefault();
          saveEditor();
        }
      });

      window.addEventListener("beforeunload", event => {
        if (
          !$("#editor").hidden &&
          draft &&
          !saving &&
          formSnapshot() !== initialSnapshot
        ) {
          event.preventDefault();
          event.returnValue = "";
        }
      });
    }

    init();
  </script>
</body>
</html>
